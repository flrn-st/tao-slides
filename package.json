{
  "name": "tao-slides",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:plugin": "tsc -b && vite build --config vite.plugin.config.ts",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "test:roundtrip": "esbuild test/roundtrip.mjs --bundle --platform=node --format=cjs --outfile=/tmp/pptx-editor-roundtrip.cjs && node /tmp/pptx-editor-roundtrip.cjs",
    "test:customer-fixture": "esbuild test/customer-feedback-fixture.mjs --bundle --platform=node --format=cjs --outfile=/tmp/pptx-editor-customer-feedback.cjs && node /tmp/pptx-editor-customer-feedback.cjs",
    "test:customer-feedback": "esbuild test/customer-feedback-fixture.mjs --bundle --platform=node --format=cjs --outfile=/tmp/pptx-editor-customer-feedback.cjs && node /tmp/pptx-editor-customer-feedback.cjs",
    "test:customer-feedback-roundtrip": "esbuild test/customer-feedback-roundtrip.mjs --bundle --platform=node --format=cjs --outfile=/tmp/pptx-editor-customer-feedback-roundtrip.cjs && node /tmp/pptx-editor-customer-feedback-roundtrip.cjs"
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.2.8",
    "@fontsource-variable/geist-mono": "^5.2.7",
    "@fontsource/instrument-serif": "^5.2.8",
    "@fontsource/roboto-mono": "^5.3.0",
    "fabric": "^5.3.0",
    "fast-xml-parser": "^4.5.0",
    "jszip": "^3.10.1",
    "nanoid": "^5.0.7",
    "pptxgenjs": "^3.12.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@types/fabric": "^5.3.11",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "puppeteer": "^25.6.0",
    "typescript": "^5.6.3",
    "vite": "^5.4.10",
    "vite-plugin-singlefile": "^2.3.0"
  }
}
